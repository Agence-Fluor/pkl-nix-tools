#!/usr/bin/env bash
set -euo pipefail

fail() { printf 'pkl-nix-tools: %s\n' "$*" >&2; exit 1; }

usage() {
  printf '%s\n' 'usage: pkl-nix-tools [path/to/flake.pkl] generate|build|develop|run|flake ...' \
    '       ./flake.pkl generate|build|develop|run|flake ...' \
    'Run Nix through an executable flake.pkl. Render only: pkl eval flake.pkl'
}
if [[ ${1:-} == --help || ${1:-} == -h ]]; then usage; exit 0; fi
[[ $# -gt 0 ]] || { usage >&2; exit 2; }
(( BASH_VERSINFO[0] >= 4 )) || fail 'Bash 4 or newer is required'

script_path=$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/${BASH_SOURCE[0]##*/}
original_args=("$@")

uri_path() {
  local LC_ALL=C source=$1 char hex i
  encoded=
  for ((i=0; i<${#source}; i++)); do
    char=${source:i:1}
    case $char in
      [a-zA-Z0-9/._~-]) encoded+=$char ;;
      *) printf -v hex '%%%02X' "'$char"; encoded+=$hex ;;
    esac
  done
}

if [[ ${1:-} == flake.pkl || ${1:-} == */flake.pkl ]]; then
  [[ -f $1 ]] || fail "flake.pkl introuvable: $1"
  root=$(cd -P -- "$(dirname -- "$1")" && pwd)
  shift
else
  root=$(pwd -P)
  while [[ ! -f $root/flake.pkl ]]; do
    [[ $root != / ]] || fail 'aucun flake.pkl trouvé dans les répertoires parents'
    root=${root%/*}
    [[ -n $root ]] || root=/
  done
  root=$(cd -P -- "$root" && pwd)
fi
if [[ ${1:-} == --help || ${1:-} == -h ]]; then usage; exit 0; fi
[[ $# -gt 0 ]] || { usage >&2; exit 2; }
project_dir=$root
pkl_project_path=
while :; do
  if [[ -f $project_dir/PklProject ]]; then
    pkl_project_path=$project_dir/PklProject
    break
  fi
  [[ $project_dir == / ]] && break
  project_dir=${project_dir%/*}
  [[ -n $project_dir ]] || project_dir=/
done
project_deps_path=
if [[ -n $pkl_project_path && -f $project_dir/PklProject.deps.json ]]; then
  project_deps_path=$project_dir/PklProject.deps.json
fi
cache_key="pkl-nix-tools-fingerprint-v3|$pkl_project_path|$project_deps_path"
uri_path "$root/flake.pkl"
entry_uri="file://$encoded"
uri_path "$root"
flake_ref="path:$encoded?dir=.pkl-nix-tools"
[[ ! -e $root/flake.nix && ! -L $root/flake.nix ]] || fail "flake.nix existe à la racine: $root/flake.nix"
[[ ! -L $root/.pkl-nix-tools ]] || fail ".pkl-nix-tools est un symlink: $root/.pkl-nix-tools"

mkdir -p -- "$root/.pkl-nix-tools"
[[ ! -L $root/.pkl-nix-tools/.gitignore ]] || fail "symlink inattendu: $root/.pkl-nix-tools/.gitignore"
[[ -f $root/.pkl-nix-tools/.gitignore ]] || printf '*\n' > "$root/.pkl-nix-tools/.gitignore"
flake=$root/.pkl-nix-tools/flake.nix
fingerprint=$root/.pkl-nix-tools/fingerprint
# One file, two names. Nix refuses symbolic lock links; a hard link lets it
# read and write the root lock without leaking global lock flags to nixpkgs.
link_lock() {
  local lock=$root/.pkl-nix-tools/flake.lock
  if [[ -f $root/flake.lock ]]; then
    if [[ -L $lock || ! $root/flake.lock -ef $lock ]]; then
      rm -f -- "$lock"
      ln -- "$root/flake.lock" "$lock"
    fi
  else
    rm -f -- "$lock"
  fi
}
link_lock

hash_file() { nix --extra-experimental-features 'nix-command flakes' hash file --type sha256 --base16 -- "$1"; }
run_pkl() { JAVA_TOOL_OPTIONS="${JAVA_TOOL_OPTIONS:+$JAVA_TOOL_OPTIONS }-XX:-UsePerfData" pkl "$@"; }

# The fingerprint is NUL-delimited so file names cannot confuse the cache parser.
cache_valid() {
  [[ -f $flake && -f $fingerprint && ! -L $flake && ! -L $fingerprint ]] || return 1
  local version path saved current count=0
  exec 3< "$fingerprint"
  IFS= read -r -d '' version <&3 || { exec 3<&-; return 1; }
  [[ $version == "$cache_key" ]] || { exec 3<&-; return 1; }
  while IFS= read -r -d '' path <&3; do
    IFS= read -r -d '' saved <&3 || { exec 3<&-; return 1; }
    [[ -f $path && ! -L $path ]] || { exec 3<&-; return 1; }
    case $path in
      *.pkl|*/PklProject)
        # A newly added glob match cannot be detected by hashing existing files.
        [[ ! $(< "$path") =~ import[[:space:]]*\* ]] || { exec 3<&-; return 1; } ;;
    esac
    current=$(hash_file "$path") || { exec 3<&-; return 1; }
    [[ $current == "$saved" ]] || { exec 3<&-; return 1; }
    ((count+=1))
  done
  exec 3<&-
  (( count >= 3 ))
}

tmp_flake='' tmp_fingerprint=''
cleanup() {
  [[ -z $tmp_flake ]] || rm -f -- "$tmp_flake"
  [[ -z $tmp_fingerprint ]] || rm -f -- "$tmp_fingerprint"
}
trap cleanup EXIT

generate() {
  local uri path file digest imports
  local -a files=("$root/flake.pkl" "$script_path")
  local -a pkl_project_args=()
  local -a graph_args=(--property "entry=$entry_uri")
  local -A seen=()
  if [[ -n $pkl_project_path ]]; then
    files+=("$pkl_project_path")
    [[ -z $project_deps_path ]] || files+=("$project_deps_path")
    pkl_project_args=(--project-dir "$project_dir")
    uri_path "$pkl_project_path"
    graph_args+=(--property "project=file://$encoded")
  fi
  # A project-local launcher refreshes itself through the same Pkl dependency
  # as the flake. The valid-cache path never starts Pkl.
  if [[ $script_path == "$root/.pkl-nix-tools/run" ]]; then
    tmp_flake=$(mktemp "$root/.pkl-nix-tools/run.XXXXXXXX")
    run_pkl eval "${pkl_project_args[@]}" -x launcher "$root/flake.pkl" -o "$tmp_flake"
    if ! cmp -s "$script_path" "$tmp_flake"; then
      mv -f -- "$tmp_flake" "$script_path"
      tmp_flake=
      exec bash "$script_path" "${original_args[@]}"
    fi
    rm -f -- "$tmp_flake"
    tmp_flake=
  fi
  imports=$(run_pkl eval "${pkl_project_args[@]}" "${graph_args[@]}" - <<'PKL'
import "pkl:analyze" as analyze
local entry = read("prop:entry")
local project = read?("prop:project")
local graph = analyze.importGraph(if (project == null) Set(entry) else Set(entry, project))
output {
  text = graph.resolvedImports.values.filter((uri) -> uri.startsWith("file:")).toList().sort().join("\n") + "\n"
}
PKL
  )
  while IFS= read -r uri; do
    [[ $uri == file:///* ]] || continue
    path=${uri#file://}
    printf -v path '%b' "${path//%/\\x}"
    [[ -f $path ]] || fail "import local introuvable: $path"
    files+=("$path")
  done <<< "$imports"

  tmp_flake=$(mktemp "$root/.pkl-nix-tools/flake.nix.XXXXXXXX")
  tmp_fingerprint=$(mktemp "$root/.pkl-nix-tools/fingerprint.XXXXXXXX")
  printf '# GENERATED BY pkl-nix-tools FROM flake.pkl. DO NOT EDIT.\n' > "$tmp_flake"
  run_pkl eval "${pkl_project_args[@]}" "$root/flake.pkl" >> "$tmp_flake"
  nix-instantiate --parse "$tmp_flake" >/dev/null

  printf '%s\0' "$cache_key" > "$tmp_fingerprint"
  for file in "${files[@]}"; do
    [[ -n ${seen[$file]+yes} ]] && continue
    seen[$file]=1
    digest=$(hash_file "$file")
    printf '%s\0%s\0' "$file" "$digest" >> "$tmp_fingerprint"
  done
  digest=$(hash_file "$tmp_flake")
  printf '%s\0%s\0' "$flake" "$digest" >> "$tmp_fingerprint"
  mv -f -- "$tmp_flake" "$flake"
  tmp_flake=
  mv -f -- "$tmp_fingerprint" "$fingerprint"
  tmp_fingerprint=
}

if [[ $1 == generate ]]; then
  [[ $# == 1 ]] || fail 'usage: pkl-nix-tools generate'
  generate
  exit 0
fi

case $1 in
  build|develop|run) command=$1; shift ;;
  flake)
    command=flake; shift
    [[ $# -gt 0 ]] || fail 'usage: pkl-nix-tools flake check|lock|update|show ...'
    subcommand=$1; shift
    case $subcommand in
      check|lock|update|show|metadata|archive|prefetch) ;;
      *) fail "unsupported flake command: $subcommand (use nix directly for flake creation)" ;;
    esac
    ;;
  *) fail "commande non prise en charge: $1" ;;
esac

ref=$flake_ref
lock_args=()
if [[ $command == flake && $subcommand == update ]]; then
  declare -a args=()
  explicit_flake=0
  after_flake=0
  current_flake=1
  for arg in "$@"; do
    if (( after_flake )); then
      case $arg in
        .) args+=("$ref"); current_flake=1 ;;
        *) args+=("$arg"); current_flake=0 ;;
      esac
      after_flake=0
      continue
    fi
    case $arg in
      --flake) args+=("$arg"); explicit_flake=1; after_flake=1 ;;
      --flake=.) args+=("--flake=$ref"); explicit_flake=1; current_flake=1 ;;
      --flake=*) args+=("$arg"); explicit_flake=1; current_flake=0 ;;
      *) args+=("$arg") ;;
    esac
  done
  if (( !explicit_flake )); then args=(--flake "$ref" "${args[@]}"); fi
  if (( current_flake )); then
    cache_valid || generate
    # The first native lock goes straight to the root. Later invocations use
    # the hard link, including Nix's normal update and override behavior.
    [[ -f $root/flake.lock ]] || lock_args=(--output-lock-file "$root/flake.lock")
  fi
  if (( ${#lock_args[@]} )); then
    nix --extra-experimental-features 'nix-command flakes' flake update "${lock_args[@]}" "${args[@]}"
    link_lock
    exit 0
  fi
  exec nix --extra-experimental-features 'nix-command flakes' flake update "${args[@]}"
fi

declare -a args=()
found_current=0
foreign_ref=0
expect_value=0
after_separator=0
expression=0
lock_write_allowed=1
lock_options=()
lock_values=0
for arg in "$@"; do
  if (( lock_values )); then
    lock_options+=("$arg"); lock_values=$((lock_values-1))
  elif (( !after_separator && !expect_value )); then
    case $arg in
      --override-input|--override-flake|--option) lock_options+=("$arg"); lock_values=2 ;;
      --update-input|--inputs-from|--store|--eval-store|--extra-experimental-features|--experimental-features) lock_options+=("$arg"); lock_values=1 ;;
      --offline|--refresh|--impure|--recreate-lock-file|--no-registries|--no-use-registries|--accept-flake-config|--allow-dirty-locks) lock_options+=("$arg") ;;
      --override-input=*|--override-flake=*|--option=*|--update-input=*|--inputs-from=*|--store=*|--eval-store=*|--extra-experimental-features=*|--experimental-features=*) lock_options+=("$arg") ;;
    esac
  fi
  if (( expect_value )); then
    args+=("$arg")
    expect_value=$((expect_value-1))
    continue
  fi
  if (( after_separator )); then args+=("$arg"); continue; fi
  case $arg in
    .) args+=("$ref"); found_current=1 ;;
    .#*) args+=("$ref${arg:1}"); found_current=1 ;;
    --) args+=("$arg"); after_separator=1 ;;
    *)
      args+=("$arg")
      case $arg in --expr|--expr=*|--file|--file=*|-f) expression=1 ;; esac
      case $arg in --no-write-lock-file|--no-update-lock-file) lock_write_allowed=0 ;; esac
      case $arg in
        --command|-c) after_separator=1 ;;
        --out-link|-o|--expr|--file|-f|--system|--store|--eval-store|--log-format|--inputs-from|--reference-lock-file|--output-lock-file|--max-jobs|-j|--cores|--builders|--substituters|--trusted-public-keys|--extra-substituters|--extra-trusted-public-keys|--update-input|--profile|--priority|--extra-experimental-features|--experimental-features|--keep|-k|--unset|-u) expect_value=1 ;;
        --arg|--argstr|--override-input|--override-flake|--redirect|--option) expect_value=2 ;;
        --*=*|-) ;;
        -*) ;;
        *) foreign_ref=1 ;;
      esac
      ;;
  esac
done
if (( !found_current && !foreign_ref && !expression )); then
  args=("$ref" "${args[@]}"); found_current=1
fi
if (( found_current )); then
  (( !foreign_ref )) || fail 'build current and external flakes in separate invocations so their lock files stay independent'
  cache_valid || generate
  if [[ ! -f $root/flake.lock ]]; then
    if [[ $command == flake && $subcommand == lock ]]; then
      lock_args=(--output-lock-file "$root/flake.lock")
    elif (( lock_write_allowed )); then
      nix --extra-experimental-features 'nix-command flakes' flake lock "$ref" \
        --output-lock-file "$root/flake.lock" "${lock_options[@]}"
      link_lock
    fi
  fi
fi

if [[ $command == flake ]]; then
  if (( ${#lock_args[@]} )); then
    nix --extra-experimental-features 'nix-command flakes' flake "$subcommand" "${lock_args[@]}" "${args[@]}"
    link_lock
    exit 0
  fi
  exec nix --extra-experimental-features 'nix-command flakes' flake "$subcommand" "${lock_args[@]}" "${args[@]}"
else
  exec nix --extra-experimental-features 'nix-command flakes' "$command" "${lock_args[@]}" "${args[@]}"
fi
