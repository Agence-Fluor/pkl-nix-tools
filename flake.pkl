#!/usr/bin/env -S pkl-nix-tools
amends "@nix/Flake.pkl"

import "@nix/Nix.pkl" as Nix

description = "Bash wrapper and Pkl package for Nix flakes"

inputs {
  ["nixpkgs"] = new Nix.Input { url = "github:NixOS/nixpkgs/nixos-unstable" }
}

local systems = List("x86_64-linux", "aarch64-linux", "x86_64-darwin", "aarch64-darwin")

devShells {
  for (system in systems) {
    [system] {
      ["default"] = new Nix.Raw {
        code =
          """
          inputs.nixpkgs.legacyPackages.\(system).mkShell {
            packages = with inputs.nixpkgs.legacyPackages.\(system); [ bash pkl nix curl unzip ];
          }
          """
      }
    }
  }
}
