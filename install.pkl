#!/usr/bin/env -S pkl run
/// Optionally prefill the project-local launcher cache.
extends "pkl:Command"

options: Options

class Options {
  directory: String(!isEmpty) = ".pkl-nix-tools"
}

output {
  files {
    [options.directory + "/.gitignore"] { text = "*\n" }
    [options.directory + "/run"] { bytes = read("pkl-nix-tools").bytes }
  }
}
