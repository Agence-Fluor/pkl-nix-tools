module pklNixTools.Imports

import "pkl:analyze" as analyze

local entry = read("prop:entry")
local project = read?("prop:project")
local graph = analyze.importGraph(if (project == null) Set(entry) else Set(entry, project))

output {
  text = graph.resolvedImports.values.filter((uri) -> uri.startsWith("file:")).toList().sort().join("\n") + "\n"
}
