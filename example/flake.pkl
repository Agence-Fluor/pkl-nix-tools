#!/usr/bin/env -S bash -ec 'd=${0%/*};r=$d/.pkl-nix-tools;test ! -L "$r";test -f "$r/run"||{ mkdir -p "$r";echo "*" >"$r/.gitignore";pkl eval -w "$d" -x launcher flake.pkl -o ".pkl-nix-tools/run.$$";mv "$r/run.$$" "$r/run";};exec bash "$r/run" "$0" "$@"'
amends "@nix/Flake.pkl"

import "@nix/Nix.pkl" as Nix

local launcher = import("@nixTools/Bootstrap.pkl").output.text

description = "pkl-nix-tools end-to-end example"

inputs {
  ["nixpkgs"] = new Nix.Input {
    url = "github:NixOS/nixpkgs/nixos-unstable"
  }
}

packages {
  ["x86_64-linux"] {
    ["hello"] = new Nix.Apply {
      callee = new Nix.Ref {
        path = "inputs.nixpkgs.legacyPackages.x86_64-linux.writeShellScriptBin"
      }
      arguments {
        "hello-pkl"
        new Nix.InterpolatedString {
          parts {
            "exec "
            new Nix.Ref { path = "inputs.nixpkgs.legacyPackages.x86_64-linux.coreutils" }
            "/bin/cat "
            new Nix.Path { value = "../message.txt" }
          }
        }
      }
    }
    ["default"] = new Nix.Ref { path = "self.packages.x86_64-linux.hello" }
  }
}

devShells {
  ["x86_64-linux"] {
    ["default"] = new Nix.MkShell {
      pkgs = new Nix.Ref { path = "inputs.nixpkgs.legacyPackages.x86_64-linux" }
      packages { new Nix.Ref { path = "self.packages.x86_64-linux.hello" } }
    }
  }
}

apps {
  ["x86_64-linux"] {
    ["hello"] = new Nix.App {
      program = new Nix.InterpolatedString {
        parts { new Nix.Ref { path = "self.packages.x86_64-linux.hello" }; "/bin/hello-pkl" }
      }
    }
    ["default"] = new Nix.Ref { path = "self.apps.x86_64-linux.hello" }
  }
}

checks {
  ["x86_64-linux"] {
    ["hello"] = new Nix.Ref { path = "self.packages.x86_64-linux.hello" }
  }
}
